    {
        "id": "ex5-comment", "type": "comment", "name": "Two stations, one flow. Simulators: npx --no -- alicat-sim --port 5020 and --port 5021",
        "info": "Each device config is one instrument (one IP, native Ethernet). Every instrument gets exactly one TCP connection, whatever the number of nodes using it.\n\nThe join sends one object per round with both stations. If a station stops answering, the object arrives after 2 s without it, and the last message from that station carries quality \"stale\" or \"offline\".",
        "x": 360, "y": 40, "wires": []
    },
    {
        "id": "ex5-dev1", "type": "alicat-device", "name": "Station 1", "host": "127.0.0.1", "port": "5020", "unitId": "1",
